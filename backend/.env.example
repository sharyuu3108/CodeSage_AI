PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/codesage?retryWrites=true&w=majority

# Gemini AI (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# Rate Limits & Quotas
AI_DAILY_QUOTA_PER_USER=50
MAX_CODE_SIZE_BYTES=51200
